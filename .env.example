# Variables usadas por docker-compose.yml. Copiar a .env y completar.
# JWT_SECRET e INTERNAL_KEY deben ser EXACTAMENTE el mismo valor en los
# cuatro microservicios: son secretos compartidos, no por servicio.

POSTGRES_PASSWORD=cambiar-por-una-clave-fuerte
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
INTERNAL_KEY=cambiar-por-otro-secreto-largo-y-aleatorio
CLAVE_ADMIN=4carneone
CLAVE_CAJA=4carneone
DOMAIN=carneone.example.com
